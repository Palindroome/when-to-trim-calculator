{
  "name": "when-to-trim-calculator",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "lint": "biome check --formatter-enabled=false",
    "lint:fix": "biome check --formatter-enabled=false --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "validate": "npm run lint && npm run format:check && npm run typecheck && npm run test:unit && npm run build",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "VISUAL=1 playwright test e2e/visual.spec.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "cally": "0.9.2"
  }
}
