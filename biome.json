{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/*.md", "!e2e/golden.json", "!public"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 140
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "trailingCommas": "all" }
  },
  "css": {
    "formatter": { "enabled": false }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "rules": { "preset": "recommended" }
  },
  "overrides": [
    {
      "includes": ["src/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/ui", "**/ui/**", "**/i18n", "**/i18n/**", "**/storage", "**/storage/**"],
                    "message": "src/domain stays pure: no UI, i18n or storage imports."
                  }
                ]
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "document": "src/domain stays pure: no DOM access.",
                  "window": "src/domain stays pure: no DOM access.",
                  "localStorage": "src/domain stays pure: no storage access."
                }
              }
            }
          }
        }
      }
    }
  ]
}
